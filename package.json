{
  "name": "creative-os",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "dev:electron": "concurrently -k -n NEXT,ELECTRON -c cyan,yellow \"next dev --turbo --hostname 127.0.0.1\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "build:electron": "next build && electron-builder",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "echo 'Skipping native rebuild in dev'"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/react": "^3.0.118",
    "@anthropic-ai/sdk": "^0.78.0",
    "@huggingface/transformers": "^3.0.0-alpha.5",
    "@imgly/background-removal": "^1.7.0",
    "@lume/kiwi": "^0.4.4",
    "@notionhq/client": "^5.11.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tabler/icons-react": "^3.41.1",
    "ai": "^6.0.116",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "fabric": "^7.2.0",
    "fontsource-space-mono": "^4.0.0",
    "fontsource-syne": "^4.0.0",
    "googleapis": "^171.4.0",
    "hugeicons-react": "^0.4.0",
    "imagetracerjs": "^1.2.6",
    "langsmith": "^0.5.18",
    "lucide-react": "^0.577.0",
    "matter-js": "^0.20.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "onnxruntime-web": "^1.21.0",
    "openai": "^6.33.0",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "remixicon": "^4.9.1",
    "roughjs": "^4.6.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.19.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.creativeos.app",
    "productName": "Creative OS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "**/*",
      "!supabase/**",
      "!*.md"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
