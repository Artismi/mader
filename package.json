{
  "name": "creative-os",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --turbo --hostname 127.0.0.1",
    "dev:electron": "concurrently -k -n NEXT,ELECTRON -c cyan,yellow \"next dev --turbo --hostname 127.0.0.1\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "next build",
    "build:electron": "next build && electron-builder",
    "start": "next start",
    "lint": "eslint",
    "asset:catalogo": "node scripts/asset/catalogo.mjs",
    "asset:caratteri": "node scripts/asset/caratteri.mjs",
    "designer:vetrina": "node scripts/designer/vetrina.mjs",
    "designer:idee": "node scripts/designer/vetrina.mjs --contenuti caffe,mostra,t_menu,palestra --formati quadrato --occhio --a-secco --idee-modello --out scripts/designer/out/idee-modello",
    "designer:foto": "node scripts/designer/foto.mjs",
    "designer:texture": "node scripts/designer/texture.mjs",
    "designer:test": "node --test scripts/designer/progetto.test.mjs scripts/designer/occhio.test.mjs scripts/asset/asset.test.mjs",
    "confronto:genera": "node scripts/confronto/genera.mjs",
    "confronto:concorrenti": "node scripts/confronto/concorrenti.mjs",
    "confronto:giuria": "node scripts/confronto/giuria.mjs",
    "confronto:giudica": "node scripts/confronto/giudica.mjs",
    "confronto:rapporto": "node scripts/confronto/rapporto.mjs",
    "confronto:test": "node --test scripts/confronto/lib.test.mjs",
    "decompila:banco": "node scripts/decompila/banco.mjs",
    "test:agente": "node --import ./scripts/agent/register.mjs --test scripts/agent/guscio.test.mts scripts/agent/registro.test.mts scripts/agent/catalogo.test.mts scripts/agent/maestra.test.mts scripts/agent/banco.test.mts scripts/agent/kernel.test.mts scripts/agent/events.test.mts scripts/agent/graph.test.mts scripts/agent/livelli.test.mts scripts/agent/banco-motore.test.mts",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.53",
    "@ai-sdk/react": "^3.0.118",
    "@anthropic-ai/sdk": "^0.78.0",
    "@huggingface/transformers": "^3.0.0-alpha.5",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/streamline-emojis": "^1.2.4",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/utils": "^3.1.7",
    "@lume/kiwi": "^0.4.4",
    "@notionhq/client": "^5.11.1",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/fiber": "^9.6.0",
    "@rmbg/model-u2netp": "^0.0.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tabler/icons-react": "^3.41.1",
    "ai": "^6.0.116",
    "blobs": "^2.3.0-beta.2",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "d3-delaunay": "^6.0.4",
    "d3-force": "^3.0.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "fabric": "^7.2.0",
    "fontsource-space-mono": "^4.0.0",
    "fontsource-syne": "^4.0.0",
    "googleapis": "^171.4.0",
    "hero-patterns": "^2.1.0",
    "hugeicons-react": "^0.4.0",
    "hyperformula": "^3.2.0",
    "imagetracerjs": "^1.2.6",
    "langsmith": "^0.5.18",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "matter-js": "^0.20.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "onnxruntime-web": "^1.30.0",
    "openai": "^6.33.0",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-force-graph-2d": "^1.29.1",
    "remixicon": "^4.9.1",
    "roughjs": "^4.6.6",
    "simplex-noise": "^4.0.3",
    "tailwind-merge": "^3.5.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "three": "^0.184.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/culori": "^4.0.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.19.15",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.creativeos.app",
    "productName": "Creative OS",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "**/*",
      "!supabase/**",
      "!*.md"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
