{
  "manifest_version": 3,
  "name": "Creative OS",
  "version": "1.0",
  "description": "Overlay intelligente per freelance creativo - sistema operativo personale.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.canva.com/*",
    "*://drive.google.com/*",
    "*://mail.google.com/*",
    "*://*.figma.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.canva.com/*",
        "*://drive.google.com/*",
        "*://mail.google.com/*",
        "*://*.figma.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
