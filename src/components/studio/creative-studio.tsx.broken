}

type ArtboardExportType = 'social' | 'story' | 'newsletter' | 'whatsapp' | 'document' | 'print'

interface Props {
  clients-: CanvasClient[]
  designProjects-: DesignProjectItem[]
  onSaveProject-: (data: {
    id: string | null
    name: string
    clientId: string | null
    canvasState: string
