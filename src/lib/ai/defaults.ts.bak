    slug: 'dic-professorotto',
    name: 'Il Professorotto — Editorial Taskmaster',
    description: 'Giudice implacabile. Standard Vogue/Wired. Bacchetta scorciatoie e esige eccellenza editoriale.',
    sort_order: 60,
    active: true,
    triggers: [
      'giudica', 'sentenza', 'standard editoriale', 'è da rivista', 'bacchetta',
